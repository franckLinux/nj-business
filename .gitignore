node_modules/
.env
.env.local
*.log
logs/
.DS_Store
*.sqlite
coverage/

# Config Claude Code locale à la machine (historique de permissions, etc.)
.claude/settings.local.json

# Pièces jointes téléversées : le dossier est versionné, pas son contenu.
backend/uploads/*
!backend/uploads/.gitkeep

# NOTE : frontend/dist n'est volontairement PAS ignoré.
# PlanetHoster (Passenger) ne lance aucune étape de build au déploiement :
# le bundle doit être construit en local (`npm run build`) puis commité.

# Archives de sauvegarde manuelle / artefacts de déploiement oubliés (ex: backend.zip, dist.zip)
*.zip

# Copies de la base de production (données clients) — jamais commitées
sauvegardes/

# PV scannés des arrêtés / inventaires (046) : stockage privé, jamais commité
backend/prive/

# Livrables, documents et captures produits par Claude (hors code) — jamais commités
Claude outputs/

# Corbeille de rangement : à vider à la main après vérification
_to_delete/
