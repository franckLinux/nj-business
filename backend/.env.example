# ============================================================
#  CaissePro — Variables d'environnement
#  Copier ce fichier en .env et renseigner vos valeurs
# ============================================================

# -- Serveur --------------------------------------------------
NODE_ENV=production
PORT=3000

# -- Base de données PostgreSQL (auto-hébergée) ---------------
# Chaîne de connexion unique — seul mode de connexion utilisé.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/NOM_BASE?schema=public"
#DATABASE_URL=postgresql://caissepro:MOT_DE_PASSE@localhost:5432/caissepro
PG_SSL=false
PG_POOL_MAX=5

# -- JWT ------------------------------------------------------
JWT_SECRET=a_generer_node_-e_crypto_randomBytes_64_hex
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# -- Sécurité -------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -- Application ----------------------------------------------
APP_NAME=CaissePro
#APP_URL=http://localhost:3000
APP_URL=https://nj-business.net
CABINET_NAME=Cabinet Expert-Comptable
DEVISE=FCFA

# -- Stockage des pièces jointes (disque local) ---------------
# Dossier relatif à la racine du projet, ou chemin absolu.
STORAGE_DIR=uploads
STORAGE_BASE_URL=/uploads
STORAGE_MAX_FILE_SIZE=5242880
JSON_BODY_LIMIT=10mb

# -- Compte super admin initial (db:seed) ---------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=a_changer
SEED_ADMIN_EMAIL=

# -- Logs -----------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# -- Email SMTP (alertes dépassement de budget) ---------------
# Laisser SMTP_HOST vide pour désactiver l'envoi d'e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adresse@domaine
SMTP_PASS=mot_de_passe_smtp
SMTP_FROM="CaissePro <adresse@domaine>"

# -- Initialisation de la base à distance ---------------------
SETUP_TOKEN=a_generer_32_caracteres_minimum

# -- Initialisation automatique au démarrage (contourne SETUP_TOKEN) -------
# À repasser à false une fois la base confirmée initialisée.
AUTO_SETUP=false
AUTO_SETUP_CONFIG=false

