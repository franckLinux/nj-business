# ============================================================
#  CaissePro — Variables d'environnement
#  Copier ce fichier en .env et renseigner vos valeurs
# ============================================================

# -- Serveur --------------------------------------------------
NODE_ENV=production
PORT=3000

# -- Base de données PostgreSQL (auto-hébergée) ---------------
# Chaîne de connexion unique — seul mode de connexion utilisé.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@127.0.0.1:5432/NOM_BASE?schema=public"
#DATABASE_URL=postgresql://caissepro:MOT_DE_PASSE@localhost:5432/caissepro
PG_SSL=false
PG_POOL_MAX=5

# -- JWT ------------------------------------------------------
JWT_SECRET=a_generer_node_-e_crypto_randomBytes_64_hex
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# -- Sécurité -------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
# Tentatives de connexion par adresse IP et par 15 minutes (10 par défaut).
LOGIN_RATE_MAX=10
# 067 — sessions : « appliquer » (défaut) = une seule session active par compte,
# contrôlée à chaque requête ; « observer » = rien n'est refusé (retour arrière rapide).
SESSIONS_CONTROLE=appliquer

# -- Application ----------------------------------------------
APP_NAME=CaissePro
#APP_URL=http://localhost:3000
APP_URL=https://nj-business.net
CABINET_NAME=Cabinet Expert-Comptable
DEVISE=FCFA

# -- Stockage des pièces jointes (disque local) ---------------
# Dossier relatif à la racine du projet, ou chemin absolu.
STORAGE_DIR=uploads
STORAGE_BASE_URL=/uploads
STORAGE_MAX_FILE_SIZE=5242880
JSON_BODY_LIMIT=10mb

# -- Compte super admin initial (db:seed) ---------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=a_changer
SEED_ADMIN_EMAIL=

# -- Logs -----------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/app.log

# -- Email SMTP (alertes dépassement de budget) ---------------
# Laisser SMTP_HOST vide pour désactiver l'envoi d'e-mails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=adresse@domaine
SMTP_PASS=mot_de_passe_smtp
SMTP_FROM="CaissePro <adresse@domaine>"

# -- Initialisation de la base à distance ---------------------
SETUP_TOKEN=a_generer_32_caracteres_minimum

# -- Initialisation automatique au démarrage (contourne SETUP_TOKEN) -------
# À repasser à false une fois la base confirmée initialisée.
AUTO_SETUP=false
AUTO_SETUP_CONFIG=false

# -- Compte de démonstration NJ COMMERCIAL (sans terminal) ------------------
# true : crée une seule fois, au démarrage, le client fictif « demo-nj-commercial »
# et ses comptes demo.* (voir tools/demo-commercial.js). Repasser à false ensuite.
DEMO_COMMERCIAL=false
DEMO_MOT_DE_PASSE=


# -- Prospects et comptes de démonstration ----------------------------------
# Lien d'activation : construit sur la PREMIÈRE adresse de APP_URL (le front).
# Jeton de la tâche quotidienne (rappels, expirations) — 32 caractères minimum.
# Cron cPanel, une fois par jour :
#   curl -s -H "X-Taches-Token: <TACHES_TOKEN>" https://backendcaisse.nj-business.net/api/taches/quotidiennes
TACHES_TOKEN=a_generer_32_caracteres_minimum
APP_NAME=NJ Caisse Pro
CABINET_NAME=Cabinet NGAN JEAN
# Contact affiché dans les e-mails aux prospects (téléphone ou e-mail)
DEMO_CONTACT=
# Lien de téléchargement du catalogue des formations (PDF sur le site du cabinet),
# ajouté au mail d'activation des prospects. Ligne absente = adresse par défaut
# https://cabinet-nganjean.com/wp-content/uploads/2026/10/Catalogue-formations-2027-CNJ.pdf
# Ligne présente mais vide = pas d'encadré catalogue.
# CATALOGUE_FORMATIONS_URL=
# Page des formations sur le site du cabinet (lien sous le bouton du catalogue).
# Ligne absente = https://cabinet-nganjean.com/formation-continue ; vide = pas de lien.
# SITE_FORMATIONS_URL=
CATALOGUE_FORMATIONS_TITRE=Catalogue des formations 2027
# Destinataire des notifications internes (défaut : e-mails des super_admin)
DEMO_NOTIF_EMAIL=
DEMO_RAPPEL_JOURS_AVANT=3
DEMO_CONSERVATION_JOURS=90
# Durée par défaut d'une démo demandée via la page publique /demande-demo (jours)
DEMO_DUREE_JOURS=30

# NJ COMMERCIAL — vérification publique des bons de commande (QR code).
# Adresse du frontend vue depuis Internet ; par défaut la PREMIÈRE adresse de APP_URL.
# Le QR code pointe vers <adresse>/verifier/<jeton>. Sans adresse, l'émission est bloquée
# (jamais de lien fictif).
#VERIFICATION_URL=https://nj-business.net
# Nombre de vérifications publiques par minute et par adresse IP (défaut 30).
#VERIFICATION_RATE_MAX=30

# ── Sauvegarde chiffrée quotidienne (tools/sauvegarde.sh, audit 20/11/2026) ──
# Phrase secrète de chiffrement des sauvegardes : 24 caractères minimum.
# À conserver AUSSI hors du serveur (gestionnaire de mots de passe) : sans elle,
# les sauvegardes sont illisibles. Générer : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SAUVEGARDE_CLE=
# Dossier des sauvegardes, HORS du dossier servi par le web (défaut : ~/sauvegardes-nj-business)
SAUVEGARDE_DIR=
# Nombre de jours conservés (défaut 30)
SAUVEGARDE_JOURS=30
