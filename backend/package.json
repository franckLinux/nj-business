{
  "name": "caisse-pro",
  "version": "2.0.0",
  "description": "Plateforme SaaS de gestion de caisse commerciale — Cabinet Expert-Comptable CEMAC",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:schema": "node db/migrate.js --schema",
    "db:migrate": "node db/migrate.js",
    "db:status": "node db/migrate.js --status",
    "db:seed": "node db/seed-admin.js",
    "db:plan": "node db/seed-plan-comptable.js",
    "db:plan:status": "node db/seed-plan-comptable.js --status",
    "db:setup": "node db/setup.js",
    "db:setup:status": "node db/setup.js --status",
    "db:config": "node db/setup.js --config",
    "db:check-drift": "node tools/check-drift.js",
    "config:export": "node tools/export-config.js",
    "deploy:check": "node tools/check-deploy.js",
    "perm:diag": "node tools/diag-permissions.js"
  },
  "//": "Les scripts sequelize:migrate* ont été retirés : sequelize-cli est gelé sur son baseline et n'est joué nulle part dans la chaîne de déploiement. Toute migration de schéma s'écrit en SQL dans db/migrations/ — voir migrations/README.md.",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "sequelize": "^6.37.8",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
