{
  "name": "caisse-pro",
  "version": "2.0.0",
  "description": "Plateforme SaaS de gestion de caisse commerciale — Cabinet Expert-Comptable CEMAC",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "node db/migrate.js --schema",
    "db:migrate": "node db/migrate.js",
    "db:status": "node db/migrate.js --status",
    "db:seed": "node db/seed-admin.js",
    "db:plan": "node db/seed-plan-comptable.js",
    "db:plan:status": "node db/seed-plan-comptable.js --status",
    "db:setup": "npm run db:schema && npm run db:plan && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
