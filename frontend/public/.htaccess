# ============================================================================
#  NJ Caisse Pro — frontend (application React « monopage »)
#  Copié tel quel dans dist/ par Vite à chaque `npm run build`.
#
#  Problème corrigé : une adresse comme /demande-demo, /activation/…, /config
#  n'existe pas comme fichier sur le serveur. Sans les règles ci-dessous,
#  Apache/LiteSpeed répond 404. Ici, tout chemin qui n'est ni un fichier ni un
#  dossier réel est servi par index.html, et React affiche la bonne page.
# ============================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obligatoire
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fichiers et dossiers réels (assets, icônes, manifest, sw.js) : servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Un fichier manquant sous /assets/ doit rester une vraie 404
  # (sinon le navigateur reçoit du HTML à la place d'un .js)
  RewriteRule ^assets/ - [L,R=404]

  # Toutes les autres routes → application React
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html et le service worker : jamais en cache (mises à jour immédiates)
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Fichiers versionnés par Vite (nom avec empreinte) : cache long
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Fichiers sensibles éventuellement déposés par erreur
<FilesMatch "(^\.env|\.map$|\.sql$|\.log$)">
  Require all denied
</FilesMatch>
